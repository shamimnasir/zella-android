<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves in a backup or a phone-to-phone transfer. Keys encrypted with this phone's Keystore
     could not be read elsewhere, and projects are large and private. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
