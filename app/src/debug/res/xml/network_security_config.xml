<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: lets tests download from a server on the developer's Mac (10.0.2.2 is the
     host as seen from the emulator). Release builds have no such file and allow HTTPS only. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
